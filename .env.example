# Next.js + Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex environment variables, set with:
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set CONVEX_TO_N8N_SECRET ...
#   npx convex env set N8N_TO_CONVEX_SECRET ...
#   npx convex env set N8N_REQUEST_WEBHOOK_URL ...
#
# Do not put Convex secrets in this Next.js file.
