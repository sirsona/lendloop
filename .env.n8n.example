# Copy to .env.n8n and replace every secret.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
CONVEX_TO_N8N_SECRET=replace-with-openssl-rand-hex-32
N8N_TO_CONVEX_SECRET=replace-with-openssl-rand-hex-32
CONVEX_SITE_URL=http://host.docker.internal:3211
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Africa/Nairobi
