    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.completeUrl}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "x-lendloop-timestamp",
              "value": "={{$json.timestamp}}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{$json.signature}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.bodyString}}",
        "options": {}
      },
      "id": "complete-reminder",
      "name": "Complete reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3300,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "console.log(`[LendLoop] reminder skipped: ${$json.status}`);\nreturn [{ json: { skipped: true, status: $json.status } }];"
      },
      "id": "skip",
      "name": "Skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        100
      ]
    }
  ],
